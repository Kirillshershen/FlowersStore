<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= @product.name %> - Flowers Store</title>

  <%= stylesheet_link_tag 'product', "data-turbo-track": "reload" %>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
</head>
<body>

 <main class="product-card-container">

  <div class="product-card-flex">
    <% if @product.image.attached? %>
      <div class="product-image-container">
        <%= image_tag @product.image, class: "product-image" %>
      </div>
    <% end %>

    <div class="product-info">
      <h1 class="product-name"><%= @product.name %></h1>

      <p class="product-type"><strong>Type:</strong> <%= @product.product_type %></p>
      <p class="product-price"><strong>Price:</strong> <%= number_to_currency(@product.price, unit: "Br", separator: ",") %></p>

<% translations = {
  "flower_type" => "Тип цветка",
  "discount" => "Скидка",
  "category" => "Категория",
  "size" => "Размер",
  "material" => "Материал",
  "diameter" => "Диаметр",
  "bouquet_type" => "Тип букета",
  "packaging" => "Упаковка",
  "flowers" => "Цветы"
} %>

<% if @product.metadata.present? %>
  <h3>Подробности:</h3>
  <ul>
    <% @product.metadata.each do |key, value| %>
      <li>
        <strong><%= translations[key] || key.humanize %>:</strong>
<% if key == "flowers" && value.is_a?(Array) %>
  <ul>
    <% 
      flower_ids = value.map { |f| f["product_id"] }
      flowers = Product.where(id: flower_ids).index_by(&:id)
    %>
    <% value.each do |flower_info| %>
      <% flower = flowers[flower_info["product_id"]] %>
      <% if flower %>
        <li>
          <%= link_to flower.name, catalog_product_path(flower) %> — <%= flower_info["quantity"] %> шт.
        </li>
      <% else %>
        <li>Неизвестный цветок (ID: <%= flower_info["product_id"] %>) — <%= flower_info["quantity"] %> шт.</li>
      <% end %>
    <% end %>
  </ul>

        <% elsif value.is_a?(Array) || value.is_a?(Hash) %>
          <pre><%= JSON.pretty_generate(value) %></pre>
        <% else %>
          <%= value %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>


      <%= button_to 'Добавить в заказ', add_item_order_path(product_id: @product.id), method: :post, class: 'add-to-order-btn' %>

      <div class="back-link">
        <%= link_to "Back to catalog", catalog_path %>
      </div>
    </div>
  </div>

</main>

  <footer>
    <!-- Футер -->
  </footer>
</body>
</html>
