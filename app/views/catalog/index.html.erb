<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catalog - Flowers Store</title>
    

    <%= stylesheet_link_tag 'catalog.css', "data-turbo-track": "reload" %>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
  </head>
  <body>

    <div class="catalog-container">
<%= form_with url: catalog_path, method: :get, local: true do %>
  <% if params[:q].present? %>
    <% params[:q].each do |key, value| %>
      <%= hidden_field_tag "q[#{key}]", value %>
    <% end %>
  <% end %>

  <div class="filter-bar">
    <div class="filter-group">
      <label for="sort" class="filter-label">Сортировка:</label>
      <select name="sort" id="sort" class="filter-select" onchange="this.form.submit()">
        <option value="">По умолчанию</option>
        <option value="price_asc" <%= 'selected' if params[:sort] == 'price_asc' %>>Сначала дешевые</option>
        <option value="price_desc" <%= 'selected' if params[:sort] == 'price_desc' %>>Сначала дорогие</option>
        <option value="name_asc" <%= 'selected' if params[:sort] == 'name_asc' %>>По названию (А–Я)</option>
        <option value="name_desc" <%= 'selected' if params[:sort] == 'name_desc' %>>По названию (Я–А)</option>
      </select>
    </div>

    <div class="filter-group">
      <label class="filter-label">Цена от:</label>
      <%= number_field_tag :min_price, params[:min_price], min: 0, step: 0.1, class: 'filter-input' %>

      <label class="filter-label">до:</label>
      <%= number_field_tag :max_price, params[:max_price], min: 0, step: 0.1, class: 'filter-input' %>

      <%= submit_tag "Применить", class: "filter-button" %>
    </div>
  </div>
<% end %>

<ul class="catalog-list">
  <% if @products.any? %>
    <% @products.each do |product| %>
      <% product_id = product.id %>
<% discounts = @discounts_by_product[product_id] || {} %>
<% base_price = product.price %>
<% final_price = discounts[:final_price] || base_price %>
<% quantity_promos = discounts[:quantity_promos] || [] %>
<li class="catalog-item">
<div class="product-image-wrapper">
<% if product.image.attached? %>
  <%= link_to image_tag(product.image, class: "product-image"), catalog_product_path(product) %>
<% end %>
</div>


  <div class="product-name">
    <%= link_to product.name, catalog_product_path(product) %>
  </div>

  <div class="product-price-container">
    <span class="base-price">
      <% if discounts[:fixed] > 0 || discounts[:percent] > 0 %>
        <s style="color: gray;"><%= number_to_currency(base_price, unit: "Br", separator: ",") %></s>
      <% else %>
        <%= number_to_currency(base_price, unit: "Br", separator: ",") %>
      <% end %>
    </span>

    <% if discounts[:fixed] > 0 || discounts[:percent] > 0 %>
      <span class="discounted-price" style="color: green; font-weight: bold;">
        <%= number_to_currency(final_price, unit: "Br", separator: ",") %> 
        (-<%= (discounts[:fixed] + base_price * discounts[:percent]/100.0).round(2) %> Br)
      </span>
    <% end %>

    <!-- Скидки по количеству — в ряд -->
    <% if quantity_promos.present? %>
      <div class="quantity-discounts-inline">
        <% quantity_promos.sort_by { |d| d[:min_quantity] }.each do |discount| %>
          <span class="inline-discount">
          от <%= discount[:min_quantity] %> шт./<%= discount[:discount_value] %>%  
          </span>
        <% end %>
      </div>
    <% end %>

  </div>

  <%= link_to 'Купить', catalog_product_path(product), class: 'add-to-order-btn' %>
</li>
      </li>
    <% end %>
  <% else %>
    <p class="no-results">Ничего не найдено.</p>
  <% end %>
</ul>


      <!-- Пагинация -->
      <div class="pagination">
<%= paginate @products, params: request.query_parameters %>
      </div>

    </div>
    
  </body>
</html>
