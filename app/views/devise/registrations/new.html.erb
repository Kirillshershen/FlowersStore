<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Регистрация</title>

  <style>
    :root {
      --primary-green: #6b9e7e;
      --dark-green: #4a8c6d;
      --light-green: #e0f0e8;
      --lighter-green: #f8faf7;
      --white: #ffffff;
      --text-dark: #333;
      --border-color: #d1e6d8;
      --error-red: #dc3545;
      --success-green: #28a745;
    }

    body {
      font-family: 'Montserrat', sans-serif;
      background-color: var(--lighter-green);
      color: var(--text-dark);
      margin: 0;
      padding: 20px;
      line-height: 1.6;
    }

    h2 {
      color: var(--dark-green);
      text-align: center;
      margin-bottom: 20px;
    }

    .auth-container {
      max-width: 500px;
      margin: 0 auto;
      background-color: var(--white);
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
    }

    .auth-container h2:first-child {
      margin-top: 0;
    }

    .field {
      margin-bottom: 20px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-weight: 500;
      color: var(--dark-green);
    }

    input[type="text"],
    input[type="email"],
    input[type="password"],
    input[type="tel"] {
      width: 100%;
      padding: 10px 15px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      font-family: 'Montserrat', sans-serif;
      font-size: 1rem;
      transition: all 0.3s ease;
    }

    input:focus {
      outline: none;
      border-color: var(--primary-green);
      box-shadow: 0 0 0 2px rgba(107, 158, 126, 0.2);
    }

    .alert,
    .notice {
      background-color: #fff3cd;
      color: #856404;
      padding: 12px 15px;
      border-radius: 6px;
      border: 1px solid #ffeeba;
      margin-bottom: 20px;
    }

    .alert {
      background-color: #f8d7da;
      color: #721c24;
      border-color: #f5c6cb;
    }

    .actions {
      margin-top: 20px;
    }

    button[type="submit"],
    input[type="submit"] {
      background-color: var(--primary-green);
      color: var(--white);
      padding: 10px 20px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 1rem;
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      width: 100%;
    }

    button[type="submit"]:hover,
    input[type="submit"]:hover {
      background-color: var(--dark-green);
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(107, 158, 126, 0.3);
    }

    .links {
      text-align: center;
      margin-top: 20px;
      font-size: 0.95rem;
    }

    .links a {
      color: var(--primary-green);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .links a:hover {
      color: var(--dark-green);
    }

    @media (max-width: 600px) {
      .auth-container {
        padding: 20px;
      }

      button[type="submit"],
      input[type="submit"] {
        font-size: 0.95rem;
      }
    }
  </style>
</head>
<body>

<div class="auth-container">
  <h2>Регистрация</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :first_name, "Ваше имя" %><br />
      <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name" %>
    </div>

    <div class="field">
      <%= f.label :last_name, "Фамилия" %><br />
      <%= f.text_field :last_name, autocomplete: "family-name" %>
    </div>

    <div class="field">
      <%= f.label :phone, "Ваш телефон" %><br />
      <%= f.telephone_field :phone, autocomplete: "tel", id: "user_phone" %>
    </div>

    <div class="field">
      <%= f.label :email, "Электронная почта" %><br />
      <%= f.email_field :email, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.label :password, "Пароль" %>
      <% if @minimum_password_length %>
        <em>(минимум <%= @minimum_password_length %> символов)</em>
      <% end %><br />
      <%= f.password_field :password, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "Подтверждение пароля" %><br />
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="actions">
      <%= f.submit "Зарегистрироваться" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>

</body>
</html>