<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Главная</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <%= stylesheet_link_tag 'glav.css', "data-turbo-track": "reload" %>
</head>
<body>

  <div class="categories-grid">
    <div class="category-column">
      <div class="category-card">
        <%= link_to catalog_index_path(tab: "rose_bouquets"), class: ("active" if params[:tab] == "rose_bouquets") do %>
          <%= image_tag "bouquet8.jpg", alt: "Букеты из роз", class: "category-image" %>
          <div class="category-title">Букеты из роз</div>
        <% end %>
      </div>

      <div class="category-card">
        <%= link_to catalog_index_path(tab: "single_flowers"), class: ("active" if params[:tab] == "single_flowers") do %>
          <%= image_tag "flower3.jpg", alt: "Цветы поштучно", class: "category-image" %>
          <div class="category-title">Цветы поштучно</div>
        <% end %>
      </div>

      <div class="category-card">
        <%= link_to catalog_index_path(tab: "toys"), class: ("active" if params[:tab] == "toys") do %>
          <%= image_tag "toy4.jpg", alt: "Игрушки", class: "category-image" %>
          <div class="category-title">Игрушки</div>
        <% end %>
      </div>
    </div>

    <div class="category-column">
      <div class="category-card">
        <%= link_to catalog_index_path(tab: "vases"), class: ("active" if params[:tab] == "vases") do %>
          <%= image_tag "vase3.jpg", alt: "Вазы", class: "category-image" %>
          <div class="category-title">Вазы</div>
        <% end %>
      </div>

      <div class="category-card">
        <%= link_to catalog_index_path(tab: "wedding_bouquets"), class: ("active" if params[:tab] == "свадебный") do %>
          <%= image_tag "bouquet3.jpg", alt: "Свадебные букеты", class: "category-image" %>
          <div class="category-title">Свадебные букеты</div>
        <% end %>
      </div>

      <div class="category-card">
        <%= link_to catalog_index_path(tab: "gift_bouquets"), class: ("active" if params[:tab] == "gift_bouquets") do %>
          <%= image_tag "bouquet9.jpg", alt: "Подарочные букеты", class: "category-image" %>
          <div class="category-title">Подарочные букеты</div>
        <% end %>
      </div>
    </div>
  </div>
</body>
</html>
