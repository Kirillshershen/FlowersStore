<h1>Заказ №<%= @order.id %></h1>

<p><strong>Пользователь:</strong> <%= @order.user.email %></p>
<p><strong>Цена:</strong> <%= number_to_currency(@order.price, unit: "Br") %></p>
<p><strong>Метод оплаты:</strong> <%= @order.payment_method %></p>
<p><strong>Метод доставки:</strong> <%= @order.delivery_method %></p>
<p><strong>Адрес доставки:</strong> <%= @order.delivery_address %></p>
<p><strong>Дата готовности:</strong> <%= @order.ready_date&.strftime("%d.%m.%Y %H:%M") %></p>
<p><strong>Статус:</strong> <%= @order.status %></p>
<p><strong>Комментарий:</strong> <%= @order.comment.presence || "Нет" %></p>
