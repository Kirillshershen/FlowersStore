<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Админ-панель - Все продукты</title>
  <%= stylesheet_link_tag 'admin', "data-turbo-track": "reload" %>
</head>
<body>
  <h1>Все продукты</h1>

  <%= link_to 'Новый продукт', new_admin_product_path, class: "new-product-link" %>

  <table>
    <thead>
      <tr>
        <th>Название</th>
        <th>Цена</th>
        <th>Тип</th>
        <th>Действия</th>
      </tr>
    </thead>

    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td><%= product.name %></td>
          <td><%= number_to_currency(product.price) %></td>
          <td><%= product.product_type %></td>
          <td>
            <%= link_to 'Показать', admin_product_path(product) %> |
            <%= link_to 'Редактировать', edit_admin_product_path(product) %> |
            <%= link_to 'Удалить', admin_product_path(product), method: :delete, data: { confirm: 'Вы уверены?' } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="pagination">
    <%= paginate @products %>
  </div>
</body>
</html>
