<%= render "admin/shared/nav" %>
<h1>Акции</h1>
<%= link_to 'Добавить акцию', new_admin_promotion_path %>
<table>
  <thead>
    <tr>
      <th>Название</th>
      <th>Тип скидки</th>
      <th>Значение</th>
      <th>Начало</th>
      <th>Окончание</th>
      <th>Активна?</th>
      <th>Действия</th>
    </tr>
  </thead>
  <tbody>
    <% @promotions.each do |promotion| %>
      <tr>
        <td><%= promotion.name %></td>
        <td><%= promotion.discount_type %></td>
        <td><%= promotion.discount_value %></td>
        <td><%= promotion.starts_at&.strftime('%d.%m.%Y %H:%M') %></td>
        <td><%= promotion.ends_at&.strftime('%d.%m.%Y %H:%M') %></td>
        <td><%= promotion.active ? "Да" : "Нет" %></td>
        <td>
          <%= link_to 'Редактировать', edit_admin_promotion_path(promotion) %> |
<%= button_to 'Удалить', admin_promotion_path(promotion), method: :delete, data: { confirm: 'Вы уверены?' } %>


        </td>
      </tr>
    <% end %>
  </tbody>
</table>
