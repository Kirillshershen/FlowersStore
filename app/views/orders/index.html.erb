<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Ваши заказы</title>
  <%= stylesheet_link_tag "orders", media: "all" %>
</head>
<body>
  <h1>Ваши заказы</h1>

  <% if @orders.any? %>
    <ul class="orders-list">
      <% @orders.each do |order| %>
        <li class="order-item">
          <strong>Заказ №<%= order.id %></strong>
          <ul class="order-products">
            <% order.product_in_orders.each do |item| %>
              <li class="order-product-item">
                <%= item.product.name %> 
                (<span class="quantity">Количество: <%= item.quantity %></span>) - 
                <span class="price">Цена: <%= item.product.price * item.quantity %> руб.</span>
              </li>
            <% end %>
          </ul>
          <p><strong>Дата оформления:</strong> <%= order.ready_date.strftime('%d-%m-%Y %H:%M') %></p>
          <p><strong>Статус:</strong> <%= order.status.capitalize %></p>
          <% unless order.status == 'отменен' || order.status == 'выполнен' %>
<%= button_to 'Отменить заказ', cancel_order_path(order), method: :patch, data: { confirm: 'Вы уверены, что хотите отменить этот заказ?' } %>

<% end %>

        </li>
      <% end %>
    </ul>
  <% else %>
    <p>У вас нет подтвержденных заказов.</p>
  <% end %>
</body>
</html>
