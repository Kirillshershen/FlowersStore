<h1>Статистика продаж</h1>

<h2>Общая сумма продаж: <%= number_to_currency(@total_revenue, unit: "BYN ") %></h2>
<h2>Топ продаваемых цветов</h2>

<canvas id="flowersChart" width="600" height="400"></canvas>




<hr>



<script>
  document.addEventListener("DOMContentLoaded", () => {
    const ctx = document.getElementById('flowersChart').getContext('2d');

    const flowerNames = <%= raw @top_flowers.map { |f| "'#{f[:flower].name}'" }.to_json %>;
    const quantities = <%= raw @top_flowers.map { |f| f[:quantity_sold] }.to_json %>;

    const chart = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: flowerNames,
        datasets: [{
          label: 'Продано штук',
          data: quantities,
          backgroundColor: 'rgba(75, 192, 192, 0.6)',
          borderColor: 'rgba(75, 192, 192, 1)',
          borderWidth: 1
        }]
      },
      options: {
        scales: {
          y: {
            beginAtZero: true,
            precision: 0
          }
        }
      }
    });
  });
</script>