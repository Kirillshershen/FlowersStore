<%= render "admin/shared/nav" %>
<h1>Пользователи</h1>

<table class="user-table">
  <thead>
    <tr>
      <th>Имя</th>
      <th>Фамилия</th>
      <th>Телефон</th>
      <th>Email</th>
      <th>Админ</th>
      <th>Действия</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
<td data-label="Имя"><%= user.first_name %></td>
<td data-label="Фамилия"><%= user.last_name %></td>
<td data-label="Телефон"><%= user.phone.presence || 'не указан' %></td>
<td data-label="Email"><%= user.email %></td>
<td data-label="Админ"><%= user.admin? ? '✅ Да' : '❌ Нет' %></td>
<td data-label="Действия"><%= link_to 'Редактировать', edit_admin_user_path(user) %></td>

      </tr>
    <% end %>
  </tbody>
</table>
<script>
.user-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 12px;
  font-family: 'Montserrat', sans-serif;
  background-color: #fff;
  box-shadow: 0 4px 12px rgba(74, 140, 109, 0.1);
  border-radius: 12px;
  overflow: hidden;
}

.user-table thead tr {
  background-color: #4a8c6d;
  color: #fff;
  text-align: left;
  font-weight: 600;
}

.user-table th,
.user-table td {
  padding: 16px 20px;
  font-size: 1rem;
  vertical-align: middle;
}

.user-table tbody tr {
  background-color: #f8faf7;
  transition: background-color 0.3s ease;
  cursor: default;
  border-radius: 8px;
}

.user-table tbody tr:hover {
  background-color: #e0f0e8;
}

.user-table tbody tr td:last-child a {
  color: #4a8c6d;
  text-decoration: none;
  font-weight: 600;
  transition: color 0.3s ease;
}

.user-table tbody tr td:last-child a:hover {
  color: #357a52;
  text-decoration: underline;
}

/* Иконки для админа */
.user-table tbody tr td:nth-child(5) {
  font-size: 1.2rem;
  text-align: center;
}

/* Адаптив для мобильных */
@media (max-width: 768px) {
  .user-table thead {
    display: none;
  }

  .user-table, 
  .user-table tbody, 
  .user-table tr, 
  .user-table td {
    display: block;
    width: 100%;
  }

  .user-table tr {
    margin-bottom: 20px;
    background-color: #f8faf7;
    border-radius: 12px;
    padding: 15px;
    box-shadow: 0 3px 8px rgba(74, 140, 109, 0.1);
  }

  .user-table td {
    text-align: right;
    padding-left: 50%;
    position: relative;
    font-size: 0.9rem;
    border: none;
  }

  .user-table td::before {
    content: attr(data-label);
    position: absolute;
    left: 20px;
    width: 45%;
    padding-left: 10px;
    font-weight: 600;
    text-align: left;
    color: #4a8c6d;
  }

  .user-table tbody tr td:last-child {
    text-align: center;
    padding-left: 0;
  }
}

</script>