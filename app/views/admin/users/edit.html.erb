<%= render "admin/shared/nav" %>
<h1>Редактировать <%= @user.email %></h1>

<%= form_with model: @user, url: admin_user_path(@user), method: :patch, local: true do |f| %>
  <div class="form-group">
    <%= f.label :first_name, "Имя" %><br />
    <%= f.text_field :first_name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :last_name, "Фамилия" %><br />
    <%= f.text_field :last_name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :phone, "Телефон" %><br />
    <%= f.text_field :phone %>
  </div>

  <div class="form-group">
    <%= f.check_box :admin %>
    <%= f.label :admin, "Администратор" %>
  </div>

  <%= f.submit "Сохранить", class: "btn btn-primary" %>
<% end %>

<br />
<%= link_to '← Назад к списку', admin_users_path %>