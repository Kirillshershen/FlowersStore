<h1>Пользователи</h1>

<table class="user-table">
  <thead>
    <tr>
      <th>Имя</th>
      <th>Фамилия</th>
      <th>Телефон</th>
      <th>Email</th>
      <th>Админ</th>
      <th>Действия</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.first_name %></td>
        <td><%= user.last_name %></td>
        <td><%= user.phone.presence || 'не указан' %></td>
        <td><%= user.email %></td>
        <td><%= user.admin? ? '✅ Да' : '❌ Нет' %></td>
        <td><%= link_to 'Редактировать', edit_admin_user_path(user) %></td>
      </tr>
    <% end %>
  </tbody>
</table>