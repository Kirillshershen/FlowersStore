
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Создать / Редактировать баннер</title>
  <!-- Подключение CSS -->
<%= stylesheet_link_tag 'banner_form', media: 'all' %>
</head>
<body>


<%= stylesheet_link_tag 'product_form', media: 'all' %>
<div class="auth-container">
<%= form_with(model: [:admin, @product], local: true, html: { multipart: true }) do |form| %>
  <% if @product.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@product.errors.count, "ошибка") %> запрещают сохранение продукта:</h2>
      <ul>
        <% @product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %><br>
    <%= form.text_field :name %>
  </div>

<div id="price-field" class="form-group">
  <%= form.label :price, "Цена" %><br>
  <%= form.number_field :price, step: 0.01, readonly: false, id: "product_price" %>
</div>
<div id="bouquet-total-price" class="bouquet-total-price" style="display: none;">
  <strong>Текущая цена букета:</strong> <span>0.00 Br</span>
</div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const productTypeSelect = document.querySelector("select[name='product[product_type]']");
    const priceField = document.getElementById("product_price");
    const flowersContainer = document.getElementById("flowers");
    const packagingSelect = document.querySelector("select[name='product[metadata][packaging]']");
if (packagingSelect) {
  packagingSelect.addEventListener("change", calculateBouquetPrice);
}

function togglePriceField() {
  const isBouquet = productTypeSelect.value === "Букет";
  
  // Скрываем/показываем поле цены
  const priceGroup = priceField.closest(".form-group");
  priceGroup.style.display = isBouquet ? "none" : "block";
  priceField.readOnly = isBouquet;

  // Показываем/скрываем текущую цену букета
  const bouquetPriceDisplay = document.getElementById("bouquet-total-price");
  if (bouquetPriceDisplay) {
    bouquetPriceDisplay.style.display = isBouquet ? "block" : "none";
  }

  if (isBouquet) calculateBouquetPrice();
}

function calculateBouquetPrice() {
  let total = 0;

  // Считаем цену цветов
  document.querySelectorAll("#flowers .flower-item").forEach(item => {
    const select = item.querySelector("select");
    const input = item.querySelector("input[type='number']");
    const productId = select?.value;
    const quantity = parseFloat(input?.value) || 0;

    if (productId && quantity > 0 && select.dataset.prices) {
      const prices = JSON.parse(select.dataset.prices);
      total += (prices[productId] || 0) * quantity;
    }
  });

  // Получаем цену упаковки
  const packagingSelect = document.querySelector("select[name='product[metadata][packaging]']");
  if (packagingSelect) {
    const packagingPrice = parseFloat(packagingSelect.options[packagingSelect.selectedIndex]?.dataset.price || 0);
    total += packagingPrice;
  }

  // Обновляем скрытое поле цены продукта
  priceField.value = total.toFixed(2);

  // Обновляем отображаемое значение цены букета
  const totalPriceDisplay = document.getElementById("bouquet-total-price")?.querySelector("span");
  if (totalPriceDisplay) {
    totalPriceDisplay.textContent = `${total.toFixed(2)} Br`;
  }
}

    // Подставляем цены как data-атрибуты для JS
    <% Product.where(product_type: "Цветок").each do |flower| %>
      document.querySelectorAll("select[name$='[product_id]']").forEach(select => {
        select.dataset.prices = select.dataset.prices ? JSON.parse(select.dataset.prices) : {};
        select.dataset.prices["<%= flower.id %>"] = <%= flower.price %>;
      });
    <% end %>

    // Отслеживаем изменения
    productTypeSelect.addEventListener("change", togglePriceField);

    // При добавлении/удалении цветка пересчитываем цену
    flowersContainer?.addEventListener("change", calculateBouquetPrice);
    flowersContainer?.addEventListener("input", calculateBouquetPrice);
    document.addEventListener("change", calculateBouquetPrice);
    document.addEventListener("input", calculateBouquetPrice);

    togglePriceField();
  });
</script>
<div>
  <%= form.label :product_type, "Тип продукта" %><br>
  <%= form.select :product_type, options_for_select(["Цветок", "Ваза", "Игрушка", "Букет"], @product.product_type), prompt: "Выберите тип продукта" %>
</div>
  <hr>
  <!-- Flower -->
  <div class="metadata-block" data-type="Цветок" style="display: none; margin-bottom: 20px;">
    <h3>Данные для Цветка</h3>
    <div>
      <%= form.label :flower_type, "Тип цветка" %><br>
      <%= text_field_tag "product[metadata][flower_type]", @product.metadata&.dig("flower_type") || "" %>
    </div>
  </div>

  <!-- Vase -->
  <div class="metadata-block" data-type="Ваза" style="display: none; margin-bottom: 20px;">
    <h3>Данные для Вазы</h3>
    <div>
      <%= form.label :size, "Размер" %><br>
      <%= text_field_tag "product[metadata][size]", @product.metadata&.dig("size") || "" %>
    </div>
    <div>
      <%= form.label :material, "Материал" %><br>
      <%= text_field_tag "product[metadata][material]", @product.metadata&.dig("material") || "" %>
    </div>
    <div>
      <%= form.label :diameter, "Диаметр" %><br>
      <%= number_field_tag "product[metadata][diameter]", @product.metadata&.dig("diameter") || "", step: 0.1 %>
    </div>
  </div>

  <!-- Toy -->
  <div class="metadata-block" data-type="Игрушка" style="display: none; margin-bottom: 20px;">
    <h3>Данные для Игрушки</h3>
    <div>
      <%= form.label :size, "Размер" %><br>
      <%= text_field_tag "product[metadata][size]", @product.metadata&.dig("size") || "" %>
    </div>
    <div>
      <%= form.label :material, "Материал" %><br>
      <%= text_field_tag "product[metadata][material]", @product.metadata&.dig("material") || "" %>
    </div>
  </div>

  <!-- Bouquet -->
<div class="metadata-block" data-type="Букет" style="display: none; margin-bottom: 20px;">
  <h3>Данные для Букета</h3>
  <div>
    <%= form.label :bouquet_type, "Тип букета" %><br>
    <%= text_field_tag "product[metadata][bouquet_type]", @product.metadata&.dig("bouquet_type") || "" %>
  </div>
  <div>
    <%= form.label :packaging, "Упаковка" %><br>
<select name="product[metadata][packaging]" id="product_metadata_packaging">
  <option value="">Выберите упаковку</option>
  <% Packaging.all.each do |package| %>
    <option value="<%= package.id %>" data-price="<%= package.price %>"><%= package.name %></option>
  <% end %>
</select>
  </div>

    <h4>Цветы в букете</h4>
    <div id="flowers">
      <% flowers = @product.metadata&.dig("flowers") || [] %>
      <% flowers.each_with_index do |flower, index| %>
        <div class="flower-item" data-index="<%= index %>">
<% @product.metadata["flowers"].each do |index, flower| %>
  <div class="flower-item" data-index="<%= index %>">
    <select name="product[metadata][flowers][<%= index %>][product_id]" 
            data-prices='<%= Product.where(product_type: 'Цветок').pluck(:id, :price).to_h.to_json %>'>
      <option value=""></option>
      <% Product.where(product_type: "Цветок").each do |flower_option| %>
        <option value="<%= flower_option.id %>" <%= "selected" if flower_option.id == flower["product_id"] %>><%= flower_option.name %></option>
      <% end %>
    </select>
    <input type="number" name="product[metadata][flowers][<%= index %>][quantity]" min="1" value="<%= flower["quantity"] %>" />
  </div>
<% end %>

        </div>
      <% end %>
    </div>
    <button type="button" id="add-flower">Добавить цветок</button>
  </div>

  <hr>

  <div>
    <%= form.label :image, "Картинка продукта" %><br>
    <%= form.file_field :image %>
  </div>

  <% if @product.image.attached? %>
    <div>
      <p>Текущая картинка:</p>
      <%= image_tag @product.image.variant(resize_to_limit: [150, 150]) %>
    </div>
  <% end %>

  <div>
    <%= form.submit %>
  </div>
<% end %>
</div>
</body>
</html>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const typeSelect = document.querySelector('select[name="product[product_type]"]');
    const metadataBlocks = document.querySelectorAll('.metadata-block');

    function updateMetadataVisibility() {
      const selectedType = typeSelect.value;
      metadataBlocks.forEach(block => {
        block.style.display = (block.dataset.type === selectedType) ? 'block' : 'none';
      });
    }

    typeSelect.addEventListener("change", updateMetadataVisibility);
    updateMetadataVisibility();

    // Логика добавления цветов для букета
    const flowersContainer = document.getElementById("flowers");
    const addFlowerBtn = document.getElementById("add-flower");

    addFlowerBtn?.addEventListener("click", () => {
      const index = flowersContainer.children.length;

      let options = `<option value=""></option>`;
      <% Product.where(product_type: "Цветок").each do |flower| %>
        options += `<option value="<%= flower.id %>"><%= flower.name %></option>`;
      <% end %>

      const newFlowerDiv = document.createElement("div");
      newFlowerDiv.classList.add("flower-item");
      newFlowerDiv.dataset.index = index;

newFlowerDiv.innerHTML = `
  <select name="product[metadata][flowers][${index}][product_id]" data-prices='<%= Product.where(product_type: 'Цветок').pluck(:id, :price).to_h.to_json %>'>
    <option value=""></option>
    <% Product.where(product_type: "Цветок").each do |flower| %>
      <option value="<%= flower.id %>"><%= flower.name %></option>
    <% end %>
  </select>
  <input type="number" name="product[metadata][flowers][${index}][quantity]" min="1" value="1" />
  <button type="button" class="remove-qp">Удалить</button>
`;

      flowersContainer.appendChild(newFlowerDiv);
    });

    flowersContainer?.addEventListener("click", (e) => {
      if (e.target.classList.contains("remove-flower")) {
        e.target.closest(".flower-item").remove();
      }
    });
  });
</script>
