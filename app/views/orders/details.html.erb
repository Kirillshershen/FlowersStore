<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Детали заказа №<%= @order.id %></title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag 'details.css', "data-turbo-track": "reload" %>
</head>
<body>
  <h1>Детали заказа №<%= @order.id %></h1>

  <div class="order-details">
    <p><strong>Статус:</strong> <span class="status-<%= @order.status %>"><%= @order.status %></span></p>
    <p><strong>Дата готовности:</strong> <%= @order.ready_date&.strftime("%d.%m.%Y %H:%M") || "не указана" %></p>
    <p><strong>Способ доставки:</strong> <%= @order.delivery_method || "не указан" %></p>
    <p><strong>Адрес доставки:</strong> <%= @order.delivery_address || "не указан" %></p>
    <p><strong>Комментарий:</strong> <%= @order.comment || "нет" %></p>
    <p><strong>Сумма:</strong> <%= number_to_currency(@order.price || 0, unit: "BYN ", separator: ",", delimiter: " ") %></p>
  </div>

  <% field_names = {
    "bouquet_type" => "Тип букета",
    "packaging" => "Упаковка"
  } %>

  <h2>Товары в заказе:</h2>

  <% @order.product_in_orders.includes(:product).each do |item| %>
    <div class="product-item">
      <% md = item.metadata %>
      <% inner_md = md["metadata"] || {} %>
      <h3><%= link_to md["name"], catalog_product_path(item.product) %></h3>

      <% if md["image_url"].present? %>
        <%= image_tag md["image_url"], width: 200 %>
      <% end %>

      <p><strong>Количество:</strong> <%= item.quantity %></p>
      <p><strong>Цена за единицу:</strong> <%= number_to_currency(md["price"].to_f, unit: "BYN ", separator: ",", delimiter: " ") %></p>

     

      <% if inner_md["flowers"].present? %>
        <p><strong>Состав букета:</strong></p>
        <ul>
          <% inner_md["flowers"].each do |_, flower_data| %>
            <% flower_product = Product.find_by(id: flower_data["product_id"]) %>
            <% if flower_product.present? %>
              <li>
                <%= link_to flower_product.name, catalog_product_path(flower_product) %> — <%= flower_data["quantity"] %> шт.
              </li>
            <% else %>
              <li>Неизвестный цветок (ID <%= flower_data["product_id"] %>) — <%= flower_data["quantity"] %> шт.</li>
            <% end %>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>
</body>
</html>
