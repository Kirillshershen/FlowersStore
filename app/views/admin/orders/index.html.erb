<%= render "admin/shared/nav" %>

<h1>Мои заказы</h1>

<%= form_with url: admin_orders_path, method: :get, local: true do |f| %>
  <div>
    <%= f.label :status, "Фильтр по статусу:" %>
    <%= f.select :status, options_for_select(["готов", "подтвержден", "завершен"].map { |s| [s.capitalize, s] }, @status_filter), include_blank: "Все статусы" %>
    <%= f.submit "Применить" %>
  </div>
<% end %>


<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Цена</th>
      <th>Статус</th>
      <th>Дата создания</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td><%= order.id %></td>
        <td><%= number_to_currency(order.price, unit: "Br") %></td>
        <td><%= order.status.capitalize %></td>
        <td><%= order.created_at.strftime("%d.%m.%Y %H:%M") %></td>
        <td><%= link_to "Просмотр", admin_order_path(order) %>
</td>
      </tr>
    <% end %>
  </tbody>
</table>
