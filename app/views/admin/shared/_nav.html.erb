<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админ-панель | Цветочная мастерская</title>
    <%= stylesheet_link_tag 'admin_panel.css', "data-turbo-track": "reload" %>
</head>
<body>
  <div class="admin-top-nav">
    <nav>
      <%= link_to "Товары", admin_products_path %>
      <%= link_to "Заказы", admin_orders_path %>
      <%= link_to "Упаковки", admin_packagings_path %>
      <%= link_to "Баннеры", admin_banners_path %>
      <%= link_to "Акции", admin_promotions_path %>
      <%= link_to "Вернуться на сайт", root_path %>
    </nav>
  </div>

  <main>
    <!-- Здесь будет основное содержимое страницы -->
    <%= yield %>
  </main>

  <footer style="margin-top: 50px; text-align: center; color: var(--dark-green); padding: 20px 0; border-top: 1px solid var(--border-color);">
    <p>Админ-панель Цветочной мастерской &copy; <%= Time.current.year %></p>
  </footer>
</body>
</html>