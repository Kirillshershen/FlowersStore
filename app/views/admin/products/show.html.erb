<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Админ-панель - Просмотр продукта</title>
  <%= stylesheet_link_tag 'admin_show', "data-turbo-track": "reload" %>
</head>
<body>
  <div class="container">
    <h1><%= @product.name %></h1>

    <div class="product-image">
      <% if @product.image.attached? %>
        <%= image_tag @product.image.variant(resize_to_limit: [300, 300]), alt: @product.name %>
      <% end %>
    </div>

    <div class="product-details">
      <p><strong>Цена:</strong> <%= number_to_currency(@product.price) %></p>
      <p><strong>Тип:</strong> <%= @product.product_type %></p>

      <p><strong>Метаданные:</strong></p>
      <pre class="metadata"><%= JSON.pretty_generate(@product.metadata || {}) %></pre>
    </div>

    <div class="actions">
      <%= link_to 'Редактировать', edit_admin_product_path(@product), class: 'btn btn-edit' %> |
      <%= link_to 'Назад', admin_products_path, class: 'btn btn-back' %>
    </div>
  </div>
</body>
</html>
