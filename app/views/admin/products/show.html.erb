<h1><%= @product.name %></h1>

<p><strong>Цена:</strong> <%= number_to_currency(@product.price) %></p>
<p><strong>Тип:</strong> <%= @product.product_type %></p>

<p><strong>Метаданные:</strong></p>
<pre><%= JSON.pretty_generate(@product.metadata || {}) %></pre>

<% if @product.image.attached? %>
  <%= image_tag @product.image.variant(resize_to_limit: [300, 300]) %>
<% end %>

<%= link_to 'Редактировать', edit_admin_product_path(@product) %> |
<%= link_to 'Назад', admin_products_path %>
