    <%= render "admin/shared/nav" %>
    <%= stylesheet_link_tag 'statistics.css', "data-turbo-track": "reload" %>
    <!-- График для цветов -->
<% if @top_flowers.any? %>
  <div class="stat-card">
    <h3>Топ продаваемых цветов</h3>
    <canvas id="flowersChart" width="600" height="400"></canvas>
  </div>
<% end %>

<!-- График для букетов -->
<% if @top_bouquets_list.any? %>
  <div class="stat-card">
    <h3>Топ продаваемых букетов</h3>
    <canvas id="bouquetChart" width="600" height="400"></canvas>
  </div>
<% end %>

<!-- JS: Графики -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script> 
<script>
  document.addEventListener("DOMContentLoaded", () => {

    // Цветы
    const ctxFlowers = document.getElementById('flowersChart')?.getContext('2d');
    if (ctxFlowers) {
      const flowerNames = <%= raw @top_flowers.map { |f| f[:name] }.to_json %>;
      const quantities = <%= raw @top_flowers.map { |f| f[:quantity_sold] }.to_json %>;

      new Chart(ctxFlowers, {
        type: 'bar',
        data: {
          labels: flowerNames,
          datasets: [{
            label: 'Продано шт.',
            data: quantities,
            backgroundColor: 'rgba(75, 192, 192, 0.6)',
            borderColor: 'rgba(75, 192, 192, 1)',
            borderWidth: 1
          }]
        },
        options: {
          plugins: {
            tooltip: {
              callbacks: {
                label: function(context) {
                  return `${context.parsed.y} шт.`;
                }
              }
            },
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { stepSize: 1 }
            }
          }
        }
      });
    }

    // Букеты
    const ctxBouquets = document.getElementById('bouquetChart')?.getContext('2d');
    if (ctxBouquets) {
      const bouquetNames = <%= raw @top_bouquets_list.map { |b| b[:name] }.to_json %>;
      const bouquetQuantities = <%= raw @top_bouquets_list.map { |b| b[:quantity_sold] }.to_json %>;

      new Chart(ctxBouquets, {
        type: 'bar',
        data: {
          labels: bouquetNames,
          datasets: [{
            label: 'Продано букетов',
            data: bouquetQuantities,
            backgroundColor: 'rgba(255, 99, 132, 0.6)',
            borderColor: 'rgba(255, 99, 132, 1)',
            borderWidth: 1
          }]
        },
        options: {
          plugins: {
            tooltip: {
              callbacks: {
                label: function(context) {
                  return `${context.parsed.y} шт.`;
                }
              }
            },
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { stepSize: 1 }
            }
          }
        }
      });
    }
  });
</script>