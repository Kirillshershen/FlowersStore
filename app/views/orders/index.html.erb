<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Ваши заказы</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* Вставить здесь CSS код выше */
  </style>
</head>
<body>
  <h1>Ваши заказы</h1>

  <% if @orders.any? %>
    <ul class="orders-list">
      <% @orders.each do |order| %>
        <li class="order-item">
          <strong>Заказ №<%= order.id %></strong>
          <ul class="order-products">
            <!-- Здесь можно вывести краткий список товаров -->
          </ul>

          <p><strong>Дата готовности заказа:</strong> <%= order.ready_date ? order.ready_date.strftime('%d-%m-%Y %H:%M') : 'Дата не указана' %></p>
          <p class="status-<%= order.status %>"><strong>Статус:</strong> <%= order.status.capitalize %></p>

          <%= link_to 'Подробнее о заказе', details_order_path(order), class: 'btn btn-info' %>

          <% unless ['отменен', 'выполнен'].include?(order.status) %>
            <%= button_to 'Отменить заказ', cancel_order_path(order), method: :patch, data: { confirm: 'Вы уверены, что хотите отменить этот заказ?' } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-orders-message">У вас нет подтвержденных заказов.</p>
  <% end %>
</body>
</html>