<div class="auth-container">
<h2>Редактирование <%= resource_name.to_s.humanize %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :first_name, "Ваше имя" %><br />
    <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name" %>
  </div>

  <div class="field">
    <%= f.label :last_name, "Фамилия" %><br />
    <%= f.text_field :last_name, autocomplete: "family-name" %>
  </div>

  <div class="field">
    <%= f.label :phone, "Ваш телефон" %><br />
    <%= f.telephone_field :phone, autocomplete: "tel", id: "phone-input" %>
  </div>

  <div class="field">
    <%= f.label :email, "Электронная почта" %><br />
    <%= f.email_field :email, autocomplete: "email" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div class="reconfirmation-message">
      Ожидает подтверждения: <%= resource.unconfirmed_email %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :password, "Пароль" %> <i>(оставьте пустым, если не хотите менять)</i><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
    <% if @minimum_password_length %>
      <br />
      <em>Минимум <%= @minimum_password_length %> символов</em>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Подтверждение пароля" %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :current_password, "Текущий пароль" %> <i>(нужен для подтверждения изменений)</i><br />
    <%= f.password_field :current_password, autocomplete: "current-password" %>
  </div>

  <div class="actions">
    <%= f.submit "Обновить" %>
  </div>
<% end %>




<%= link_to "Назад", :back %>
  </div>
 <%= stylesheet_link_tag 'auth_form', "data-turbo-track": "reload" %>
<!-- Стили -->
<link rel="stylesheet" href="/assets/css/auth_form.css">

<!-- Inputmask библиотека -->
<script src="https://cdn.jsdelivr.net/npm/inputmask@5.0.8/dist/inputmask.min.js"></script>    

<!-- JS маски для телефона -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const phoneInput = document.getElementById("phone-input");
    if (phoneInput) {
      // Простая маска: +375 (__) ___-__-__
      new Inputmask("+375 (99) 999-99-99", {
        placeholder: "+375 (__) ___-__-__",
        showMaskOnHover: false,
        autoUnmask: true,
        removeMaskOnSubmit: true
      }).mask(phoneInput);
    }
  });
</script>